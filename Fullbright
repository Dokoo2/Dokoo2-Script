-- Функция для создания ползунков
local function createControl(name, min, max, default, positionY, callback)
    local container = Instance.new("Frame")
    container.Size = UDim2.new(0.9, 0, 0, 50)
    container.Position = UDim2.new(0.05, 0, 0, positionY)
    container.BackgroundTransparency = 1
    container.Parent = mainFrame

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 0, 20)
    label.BackgroundTransparency = 1
    label.Text = name
    label.TextColor3 = COLORS.Text
    label.Font = Enum.Font.Gotham
    label.TextSize = 14
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = container

    local textBox = Instance.new("TextBox")
    textBox.Size = UDim2.new(0, 50, 0, 25)
    textBox.Position = UDim2.new(1, -50, 0, 0)
    textBox.BackgroundColor3 = COLORS.Button
    textBox.TextColor3 = COLORS.Text
    textBox.Font = Enum.Font.Gotham
    textBox.TextSize = 12
    textBox.Text = tostring(default)
    textBox.Parent = container
    addStroke(textBox, COLORS.Outline, 1)
    local tbCorner = Instance.new("UICorner")
    tbCorner.CornerRadius = UDim.new(0, 4)
    tbCorner.Parent = textBox

    local sliderBg = Instance.new("Frame")
    sliderBg.Size = UDim2.new(1, -60, 0, 6)
    sliderBg.Position = UDim2.new(0, 0, 0, 32)
    sliderBg.BackgroundColor3 = COLORS.Button
    sliderBg.BorderSizePixel = 0
    sliderBg.Parent = container
    addStroke(sliderBg, COLORS.Outline, 1)
    local sbgCorner = Instance.new("UICorner")
    sbgCorner.CornerRadius = UDim.new(0, 3)
    sbgCorner.Parent = sliderBg

    local sliderFill = Instance.new("Frame")
    sliderFill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
    sliderFill.BackgroundColor3 = COLORS.Accent
    sliderFill.BorderSizePixel = 0
    sliderFill.Parent = sliderBg
    local sfCorner = Instance.new("UICorner")
    sfCorner.CornerRadius = UDim.new(0, 3)
    sfCorner.Parent = sliderFill

    local sliderKnob = Instance.new("Frame")
    sliderKnob.Size = UDim2.new(0, 12, 0, 16)
    sliderKnob.Position = UDim2.new((default - min) / (max - min), -6, 0.5, -8)
    sliderKnob.BackgroundColor3 = COLORS.Accent
    sliderKnob.BorderSizePixel = 0
    sliderKnob.Parent = sliderBg
    addStroke(sliderKnob, COLORS.Outline, 1)
    local skCorner = Instance.new("UICorner")
    skCorner.CornerRadius = UDim.new(0, 4)
    skCorner.Parent = sliderKnob

    local dragging = false
    local function updateSlider(value)
        value = math.clamp(value, min, max)
        local alpha = (value - min) / (max - min)
        sliderFill.Size = UDim2.new(alpha, 0, 1, 0)
        sliderKnob.Position = UDim2.new(alpha, -6, 0.5, -8)
        textBox.Text = tostring(math.floor(value * 100 + 0.5) / 100)
        callback(value)
    end

    sliderKnob.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
        end
    end)
    
    sliderBg.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            local val = min + ((input.Position.X - sliderBg.AbsolutePosition.X) / sliderBg.AbsoluteSize.X) * (max - min)
            updateSlider(val)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local val = min + ((input.Position.X - sliderBg.AbsolutePosition.X) / sliderBg.AbsoluteSize.X) * (max - min)
            updateSlider(val)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    textBox.FocusLost:Connect(function()
        local num = tonumber(textBox.Text)
        if num then
            updateSlider(num)
        else
            textBox.Text = tostring(default)
        end
    end)
end

