-- ================= TOGGLE LOGIC (Right Ctrl) =================
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    -- Если ввод был обработан игрой (например, открыт чат), игнорируем
    if gameProcessed then return end
    
    -- Проверяем, что нажата именно Right Ctrl (RightControl)
    if input.KeyCode == Enum.KeyCode.RightControl then
        -- Если меню уже загрузилось (загрузка скрыта), переключаем видимость
        if not loadingFrame.Visible then
            mainFrame.Visible = not mainFrame.Visible
        end
    end
end)

