-- ================== LOGIC (Aimbot & ESP) ==================
function isTeammate(player)
    if not IGNORE_TEAMMATES then return false end
    if LocalPlayer.Team == nil or player.Team == nil then return false end
    return player.Team == LocalPlayer.Team
end

-- ================== ESP ==================
local espHighlights = {}

local function getColorFor(obj)
    if obj:IsA("Model") then
        local player = Players:GetPlayerFromCharacter(obj)
        if player then
            if LocalPlayer.Team ~= nil and player.Team ~= nil and player.Team == LocalPlayer.Team then
                return ALLY_COLOR
            else
                return ENEMY_COLOR
            end
        else
            return NPC_COLOR
        end
    end
    return NPC_COLOR
end

local function applyESP(obj)
    if not espEnabled then return end
    
    local player = Players:GetPlayerFromCharacter(obj)
    local isPlayer = player ~= nil
    if isPlayer and obj == LocalPlayer.Character then return end
    
    local isTarget = false
    if obj:IsA("Model") then
        local hum = obj:FindFirstChildOfClass("Humanoid")
        local head = obj:FindFirstChild("Head")
        if (hum and hum.Health > 0) or (head and head:IsA("BasePart") and not hum) then
            isTarget = true
        end
    end

    if not isTarget then
        if espHighlights[obj] then
            espHighlights[obj]:Destroy()
            espHighlights[obj] = nil
        end
        return
    end

    local h = espHighlights[obj]
    if not h then
        h = Instance.new("Highlight")
        h.Name = "AimbotESP"
        h.FillTransparency = 0.65
        h.OutlineTransparency = 0.2
        h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        h.Parent = obj
        espHighlights[obj] = h
    end
    if h.Parent ~= obj then h.Parent = obj end

    h.FillColor = getColorFor(obj)
    h.OutlineColor = getColorFor(obj)
end

function clearAllESP()
    for obj, h in pairs(espHighlights) do 
        if h and h.Parent then h:Destroy() end 
    end
    espHighlights = {}
end

-- ================== КЕШИРОВАНИЕ ГОЛОВ (Только живые) ==================
local function updateHeadsCache()
    local newHeads = {}
    
    -- 1. Игроки
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local head = p.Character:FindFirstChild("Head")
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if head and hum and hum.Health > 0 then
                table.insert(newHeads, { part = head, model = p.Character, isPlayer = true })
            end
        end
    end

    -- 2. NPC (из списка найденных)
    for _, npc in ipairs(npcList) do
        if npc and npc.Parent then
            local head = npc:FindFirstChild("Head")
            local hum = npc:FindFirstChildOfClass("Humanoid")
            if head and (not hum or hum.Health > 0) then
                table.insert(newHeads, { part = head, model = npc, isPlayer = false })
            end
        end
    end

    cachedHeads = newHeads
end

