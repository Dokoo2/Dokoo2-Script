local function getTarget()
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
    if not myRoot or (myHum and myHum.Health <= 0) then return nil end
    
    local bestTarget, bestDist = nil, math.huge
    
    for _, data in ipairs(cachedHeads) do
        local head = data.part
        local model = data.model
        
        local targetHum = model:FindFirstChildOfClass("Humanoid")
        local isAlive = true
        if targetHum then
            isAlive = targetHum.Health > 0
        end
        
        if head and head.Parent and isAlive then
            local isTeammateObj = false
            if data.isPlayer then
                local plr = Players:GetPlayerFromCharacter(model)
                if plr and isTeammate(plr) then
                    isTeammateObj = true
                end
            end
            
            if not isTeammateObj then
                local dist = (head.Position - myRoot.Position).Magnitude
                if dist <= AIMBOT_RADIUS then
                    local toTarget = head.Position - Camera.CFrame.Position
                    local horiz = math.abs(toTarget:Dot(Camera.CFrame.RightVector))
                    local vert = math.abs(toTarget:Dot(Camera.CFrame.UpVector))
                    local depth = toTarget:Dot(Camera.CFrame.LookVector)
                    
                    if depth > 0 and (horiz*horiz + vert*vert) <= (AIM_TARGET_RADIUS * AIM_TARGET_RADIUS) then
                        if dist < bestDist then 
                            bestDist = dist
                            bestTarget = head.Position 
                        end
                    end
                end
            end
        end
    end
    return bestTarget
end

RunService.RenderStepped:Connect(function(dt)
    if not aimbotEnabled then return end
    local targetPos = getTarget()
    if not targetPos then return end
    local desired = CFrame.lookAt(Camera.CFrame.Position, targetPos)
    if SMOOTHNESS <= 0.001 then
        Camera.CFrame = desired
    else
        Camera.CFrame = Camera.CFrame:Lerp(desired, math.clamp(dt / SMOOTHNESS, 0, 1))
    end
end)

